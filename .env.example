# Copy to .env and fill in. Never commit .env.

# Required: app credentials from 阿里邮箱域管后台 → API 开放平台 / 应用管理
ALIMAIL_CLIENT_ID=
ALIMAIL_CLIENT_SECRET=

# Cluster endpoint (cn / sg / hk / de ...). Default: https://alimail-cn.aliyuncs.com
# ALIMAIL_API_BASE=https://alimail-cn.aliyuncs.com

# true (default) = only read tools are registered
ALIMAIL_READ_ONLY=true

# Toolsets to enable (comma separated): users,departments,groups,contacts,org,security,audit,login
# Default: all except "login" (passwordless login links). "all" enables every toolset including login.
# ALIMAIL_TOOLSETS=users,departments,groups

# Restrict operations to these mail domains (comma separated). Empty = unrestricted.
# ALIMAIL_ALLOWED_DOMAINS=example.com

# Client-side rate limit (the whole mail domain shares 40 req/s across all apps)
# ALIMAIL_MAX_QPS=20

# Audit log file for write operations (default: stderr)
# ALIMAIL_AUDIT_LOG=/var/log/alimail-mcp-audit.jsonl

# ---- HTTP mode only ----
# Optional bearer token required by POST /mcp
# MCP_AUTH_TOKEN=
# Extra hostnames accepted in the Host header (default: localhost,127.0.0.1,[::1])
# MCP_ALLOWED_HOSTS=
