{
  "name": "@mfc-open/alimail-admin-mcp",
  "version": "0.1.0",
  "description": "MCP server for Alibaba Mail (阿里邮箱) admin OpenAPI — users and departments management (unofficial)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfc-open/alimail-admin-mcp.git"
  },
  "homepage": "https://github.com/mfc-open/alimail-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/mfc-open/alimail-admin-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "alimail-admin-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alimail",
    "aliyun",
    "阿里邮箱"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
